# Safe manual-serving gpt-oss-120B AR+RMSNorm profile on MI350X.
export MODEL_PATH="${MODEL_PATH:-/data/models/openai/gpt-oss-120b}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-gpt-oss-120b}"
export MODEL_LABEL="${MODEL_LABEL:-gpt-oss-120b}"
export HIDDEN_SIZE="${HIDDEN_SIZE:-2880}"
export HARDWARE_LABEL="${HARDWARE_LABEL:-mi350x}"
export AR_NORM_PROFILE_ID="${AR_NORM_PROFILE_ID:-gpt-oss-120b-mi350x-triton-core-v3}"
export TS_TRITON_SHMEM_PROFILE_PURE_TP="${TS_TRITON_SHMEM_PROFILE_PURE_TP:-1}"

export COMM_FUSION_MAX_NUM_TOKENS="${COMM_FUSION_MAX_NUM_TOKENS:-2048}"
export TS_TRITON_SHMEM_COARSE="${TS_TRITON_SHMEM_COARSE:-1}"
export TS_TRITON_SHMEM_ONESHOT_MAX_M="${TS_TRITON_SHMEM_ONESHOT_MAX_M:-384}"
export TS_TRITON_SHMEM_ONESHOT_BLOCK_N="${TS_TRITON_SHMEM_ONESHOT_BLOCK_N:-0}"
export TS_TRITON_SHMEM_ONESHOT_VARIANT="${TS_TRITON_SHMEM_ONESHOT_VARIANT:-padded}"
export TS_TRITON_SHMEM_PADDED_MAX_M="${TS_TRITON_SHMEM_PADDED_MAX_M:-64}"
export TS_TRITON_SHMEM_ONESHOT_NUM_WARPS="${TS_TRITON_SHMEM_ONESHOT_NUM_WARPS:-4}"
export TS_TRITON_SHMEM_TWOSHOT_BLOCK_N="${TS_TRITON_SHMEM_TWOSHOT_BLOCK_N:-0}"
export TS_TRITON_SHMEM_INKERNEL_BARRIER="${TS_TRITON_SHMEM_INKERNEL_BARRIER:-1}"
export TS_TRITON_SHMEM_WORKGROUP_SYNC="${TS_TRITON_SHMEM_WORKGROUP_SYNC:-1}"
export TS_TRITON_SHMEM_FOLD_COPYIN="${TS_TRITON_SHMEM_FOLD_COPYIN:-0}"
export TS_TRITON_SHMEM_OUTPUT_RING="${TS_TRITON_SHMEM_OUTPUT_RING:-72}"
export TS_TRITON_SHMEM_INPUT_SITE_RING="${TS_TRITON_SHMEM_INPUT_SITE_RING:-72}"
export TS_TRITON_SHMEM_BORROW_TWOSHOT_OUTPUT="${TS_TRITON_SHMEM_BORROW_TWOSHOT_OUTPUT:-1}"
export TS_TRITON_SHMEM_DOUBLE_BUFFER_INPUT="${TS_TRITON_SHMEM_DOUBLE_BUFFER_INPUT:-0}"
export TS_TRITON_SHMEM_GRID_CAP="${TS_TRITON_SHMEM_GRID_CAP:-128}"
export TS_TRITON_SHMEM_GRID_CAP_MIN_M="${TS_TRITON_SHMEM_GRID_CAP_MIN_M:-256}"
export TS_TRITON_SHMEM_BARRIER_GRID="${TS_TRITON_SHMEM_BARRIER_GRID:-0}"
export TS_TRITON_SHMEM_FUSION_MAX_M="${TS_TRITON_SHMEM_FUSION_MAX_M:-0}"

# Graph-padding rows use the reserved request-pool sink row; the former slot-0
# alias produced KV-page-stride underflow faults. Base memory, overlap, health,
# decode-graph, and prefill-graph behavior remain unchanged by this profile.
# Folded copy-in is disabled after a full serving campaign invalidated the
# narrower single-wave synthetic proof. The 72-site output and input rings bind
# captured fused calls to graph-stable per-site buffers. Delayed input-slot
# reuse removes the one-shot exit barrier without mutable two-slot replay phase.
# M<=64 uses a scratch-free 4096-lane padded whole-row kernel; larger one-shot
# calls keep the blocked kernel so the decode optimization does not regress
# M256/M384 eager guardrails.
# Eager two-shot calls ping-pong symmetric outputs and skip local copy-out;
# captured calls above the persistent M384 output-ring cap decline to the
# complete ordinary fallback.

export AR_NORM_SERVE_ARGS="${AR_NORM_SERVE_ARGS:---max-model-len 131072 --kv-cache-dtype fp8 --chunked-prefill-size 8192 --max-num-seqs 256 --reasoning-parser base --policy round_robin --kvstore-size 8}"

