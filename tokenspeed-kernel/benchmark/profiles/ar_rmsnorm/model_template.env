# Copy this file and validate every performance policy for the target model.
export MODEL_PATH="${MODEL_PATH:?set MODEL_PATH}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-$(basename "$MODEL_PATH")}"
export MODEL_LABEL="${MODEL_LABEL:-$SERVED_MODEL_NAME}"
export HIDDEN_SIZE="${HIDDEN_SIZE:?set HIDDEN_SIZE}"
export HARDWARE_LABEL="${HARDWARE_LABEL:-unknown-hardware}"

export COMM_FUSION_MAX_NUM_TOKENS="${COMM_FUSION_MAX_NUM_TOKENS:-2048}"

# Conservative starting point for an unqualified model. Override only after
# operator, graph-transition, and matched e2e validation.
export TS_TRITON_SHMEM_ONESHOT_MAX_M="${TS_TRITON_SHMEM_ONESHOT_MAX_M:-0}"
export TS_TRITON_SHMEM_ONESHOT_BLOCK_N="${TS_TRITON_SHMEM_ONESHOT_BLOCK_N:-0}"
export TS_TRITON_SHMEM_INKERNEL_BARRIER="${TS_TRITON_SHMEM_INKERNEL_BARRIER:-0}"
export TS_TRITON_SHMEM_GRID_CAP="${TS_TRITON_SHMEM_GRID_CAP:-0}"
export TS_TRITON_SHMEM_GRID_CAP_MIN_M="${TS_TRITON_SHMEM_GRID_CAP_MIN_M:-0}"

export AR_NORM_SERVE_ARGS="${AR_NORM_SERVE_ARGS:-}"

