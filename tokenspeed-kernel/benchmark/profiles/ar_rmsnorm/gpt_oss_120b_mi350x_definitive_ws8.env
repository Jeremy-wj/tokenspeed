# Planned GPT-OSS-120B WS8 profile; device identity is frozen at campaign launch.
export AR_NORM_WORLD_SIZE=8
: "${AR_NORM_DEVICES:?set eight preflight-qualified devices before sourcing}"
export AR_NORM_PROFILE_FILE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/gpt_oss_120b_mi350x_definitive_ws8.env"
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/gpt_oss_120b_mi350x_definitive_common.env"
