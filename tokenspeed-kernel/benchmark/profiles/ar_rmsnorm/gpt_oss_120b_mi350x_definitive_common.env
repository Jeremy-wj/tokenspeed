# Shared current-machine policy for GPT-OSS definitive WS2/4/8 profiles.
# Source one of the world-size wrapper files, not this file directly.

: "${AR_NORM_WORLD_SIZE:?source a definitive WS wrapper}"
: "${AR_NORM_DEVICES:?set the preflight-qualified device list}"

case "${AR_NORM_WORLD_SIZE}" in
  2|4|8) ;;
  *) echo "unsupported definitive GPT-OSS world size: ${AR_NORM_WORLD_SIZE}" >&2; return 1 ;;
esac

export GPT_OSS_DEFINITIVE_FUSION_MAX_M="${GPT_OSS_DEFINITIVE_FUSION_MAX_M:-0}"
case "${GPT_OSS_DEFINITIVE_FUSION_MAX_M}" in
  0|64|91|384) ;;
  *)
    echo "GPT_OSS_DEFINITIVE_FUSION_MAX_M must be 0, 64, 91, or 384" >&2
    return 1
    ;;
esac

export MODEL_PATH="${MODEL_PATH:-/data/models/openai-gpt-oss-120b}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-gpt-oss-120b}"
export MODEL_LABEL="${MODEL_LABEL:-gpt-oss-120b}"
export HIDDEN_SIZE="${HIDDEN_SIZE:-2880}"
export HARDWARE_LABEL="${HARDWARE_LABEL:-mi350x}"
export AR_NORM_PROFILE_ID="gpt-oss-120b-mi350x-definitive-ws${AR_NORM_WORLD_SIZE}-cap${GPT_OSS_DEFINITIVE_FUSION_MAX_M}-v1"
export AR_NORM_IGNORED_BUSY_GPUS="${AR_NORM_IGNORED_BUSY_GPUS:--1}"
export TS_TRITON_SHMEM_PROFILE_PURE_TP=1

export COMM_FUSION_MAX_NUM_TOKENS=2048
export TS_TRITON_SHMEM_COARSE=1
export TS_TRITON_SHMEM_ONESHOT_MAX_M=384
export TS_TRITON_SHMEM_ONESHOT_BLOCK_N=0
export TS_TRITON_SHMEM_ONESHOT_VARIANT=padded
export TS_TRITON_SHMEM_PADDED_MAX_M=64
export TS_TRITON_SHMEM_ONESHOT_NUM_WARPS=4
export TS_TRITON_SHMEM_TWOSHOT_BLOCK_N=0
export TS_TRITON_SHMEM_INKERNEL_BARRIER=1
export TS_TRITON_SHMEM_WORKGROUP_SYNC=1
export TS_TRITON_SHMEM_FOLD_COPYIN=0
export TS_TRITON_SHMEM_OUTPUT_RING=72
export TS_TRITON_SHMEM_INPUT_SITE_RING=72
export TS_TRITON_SHMEM_BORROW_TWOSHOT_OUTPUT=1
export TS_TRITON_SHMEM_DOUBLE_BUFFER_INPUT=0
export TS_TRITON_SHMEM_BARRIER_GRID=0
export TS_TRITON_SHMEM_FUSION_MIN_M=0
export TS_TRITON_SHMEM_FUSION_MAX_M="${GPT_OSS_DEFINITIVE_FUSION_MAX_M}"

if [[ "${AR_NORM_WORLD_SIZE}" == "4" ]]; then
  export TS_TRITON_SHMEM_GRID_CAP=128
  export TS_TRITON_SHMEM_GRID_CAP_MIN_M=256
else
  export TS_TRITON_SHMEM_GRID_CAP=0
  export TS_TRITON_SHMEM_GRID_CAP_MIN_M=0
fi

export AR_NORM_SERVE_ARGS="${AR_NORM_SERVE_ARGS:---max-model-len 131072 --kv-cache-dtype fp8 --chunked-prefill-size 8192 --max-num-seqs 256 --reasoning-parser base --policy round_robin --kvstore-size 8}"
