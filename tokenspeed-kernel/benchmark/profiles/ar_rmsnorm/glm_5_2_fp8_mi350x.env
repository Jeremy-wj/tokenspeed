# GLM-5.2-FP8 AR+RMSNorm candidate profile on 8x MI350X.
export MODEL_PATH="${MODEL_PATH:-/data/models/hf/hub/models--zai-org--GLM-5.2-FP8/snapshots/70311cfa0158cce7dd2cf5d2e04f68e3fdc3efc1}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-glm-5.2-fp8}"
export MODEL_LABEL="${MODEL_LABEL:-glm-5.2-fp8}"
export HIDDEN_SIZE="${HIDDEN_SIZE:-6144}"
export HARDWARE_LABEL="${HARDWARE_LABEL:-mi350x}"
export AR_NORM_PROFILE_FILE="${AR_NORM_PROFILE_FILE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/glm_5_2_fp8_mi350x.env}"
export AR_NORM_PROFILE_ID="${AR_NORM_PROFILE_ID:-glm-5.2-fp8-mi350x-triton-v1}"
export AR_NORM_WORLD_SIZE="${AR_NORM_WORLD_SIZE:-8}"
export AR_NORM_DEVICES="${AR_NORM_DEVICES:-0,1,2,3,4,5,6,7}"
export AR_NORM_IGNORED_BUSY_GPUS="${AR_NORM_IGNORED_BUSY_GPUS:--1}"
export TS_TRITON_SHMEM_PROFILE_PURE_TP="${TS_TRITON_SHMEM_PROFILE_PURE_TP:-1}"

export COMM_FUSION_MAX_NUM_TOKENS="${COMM_FUSION_MAX_NUM_TOKENS:-32}"
export TS_TRITON_SHMEM_COARSE="${TS_TRITON_SHMEM_COARSE:-1}"
export TS_TRITON_SHMEM_ONESHOT_MAX_M="${TS_TRITON_SHMEM_ONESHOT_MAX_M:-32}"
export TS_TRITON_SHMEM_ONESHOT_BLOCK_N="${TS_TRITON_SHMEM_ONESHOT_BLOCK_N:-0}"
export TS_TRITON_SHMEM_ONESHOT_VARIANT="${TS_TRITON_SHMEM_ONESHOT_VARIANT:-padded}"
export TS_TRITON_SHMEM_PADDED_MAX_M="${TS_TRITON_SHMEM_PADDED_MAX_M:-32}"
export TS_TRITON_SHMEM_ONESHOT_NUM_WARPS="${TS_TRITON_SHMEM_ONESHOT_NUM_WARPS:-4}"
export TS_TRITON_SHMEM_TWOSHOT_BLOCK_N="${TS_TRITON_SHMEM_TWOSHOT_BLOCK_N:-0}"
export TS_TRITON_SHMEM_INKERNEL_BARRIER="${TS_TRITON_SHMEM_INKERNEL_BARRIER:-1}"
export TS_TRITON_SHMEM_WORKGROUP_SYNC="${TS_TRITON_SHMEM_WORKGROUP_SYNC:-1}"
export TS_TRITON_SHMEM_FOLD_COPYIN="${TS_TRITON_SHMEM_FOLD_COPYIN:-0}"
export TS_TRITON_SHMEM_OUTPUT_RING="${TS_TRITON_SHMEM_OUTPUT_RING:-156}"
export TS_TRITON_SHMEM_INPUT_SITE_RING="${TS_TRITON_SHMEM_INPUT_SITE_RING:-156}"
export TS_TRITON_SHMEM_BORROW_TWOSHOT_OUTPUT="${TS_TRITON_SHMEM_BORROW_TWOSHOT_OUTPUT:-0}"
export TS_TRITON_SHMEM_DOUBLE_BUFFER_INPUT="${TS_TRITON_SHMEM_DOUBLE_BUFFER_INPUT:-0}"
export TS_TRITON_SHMEM_GRID_CAP="${TS_TRITON_SHMEM_GRID_CAP:-0}"
export TS_TRITON_SHMEM_GRID_CAP_MIN_M="${TS_TRITON_SHMEM_GRID_CAP_MIN_M:-0}"
export TS_TRITON_SHMEM_BARRIER_GRID="${TS_TRITON_SHMEM_BARRIER_GRID:-0}"
export TS_TRITON_SHMEM_FUSION_MAX_M="${TS_TRITON_SHMEM_FUSION_MAX_M:-0}"

export TS_SERVE_ENGINE_MODULE="${TS_SERVE_ENGINE_MODULE:-tokenspeed.runtime.entrypoints.safe_smg_server}"
export TOKENSPEED_DEEP_HEALTH_MODE="${TOKENSPEED_DEEP_HEALTH_MODE:-passive}"
export TOKENSPEED_PASSIVE_HEALTH_STUCK_SEC="${TOKENSPEED_PASSIVE_HEALTH_STUCK_SEC:-3600}"

# The base GLM recipe could not reach bounded readiness on this image. This
# screening profile uses the smallest changed serving state that completed:
# radix scheduler, eager execution, passive deep health, and no active KVStore.
export AR_NORM_SERVE_ARGS="${AR_NORM_SERVE_ARGS:---max-model-len 80000 --kv-cache-dtype fp8 --chunked-prefill-size 8192 --max-num-seqs 16 --trust-remote-code --enable-expert-parallel --moe-backend triton --reasoning-parser glm45 --enforce-eager --disable-cuda-graph-padding --disable-kvstore --kvstore-ratio 0 --gateway-startup-timeout 300}"
