# Planned GPT-OSS-120B WS4 profile; device identity is frozen at campaign launch.
export AR_NORM_WORLD_SIZE=4
: "${AR_NORM_DEVICES:?set four preflight-qualified devices before sourcing}"
export AR_NORM_PROFILE_FILE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/gpt_oss_120b_mi350x_definitive_ws4.env"
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/gpt_oss_120b_mi350x_definitive_common.env"
